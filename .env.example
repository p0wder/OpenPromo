# Required: a long random key callers send as `Authorization: Bearer <key>`.
# Several keys may be given, comma-separated (to rotate one without downtime).
OPENPROMO_API_KEY=

# Supplier logins normally come with each request, in the headers
# GET /v1/suppliers/{id} names. Optional default logins follow one rule for
# every supplier: {SUPPLIER}_{FIELD}, all of a supplier's fields or none.
#
# A default SanMar login for requests that send none, when you
# self-host for one account (a sanmar.com web-services user; create one at
# https://www.sanmar.com/signup/webuser once SanMar has onboarded you).
SANMAR_CUSTOMER_NUMBER=
SANMAR_USERNAME=
SANMAR_PASSWORD=
# "production" (default) or "edev", SanMar's test environment, which has its
# own logins from SanMar Integration Support.
SANMAR_ENVIRONMENT=production
# "on" only if SanMar set your account up for Warehouse Selection.
SANMAR_WAREHOUSE_SELECTION=

# A default S&S Activewear login: the account number and an API key.
SSACTIVEWEAR_ACCOUNT_NUMBER=
SSACTIVEWEAR_API_KEY=

# A directory supplier the same way, e.g. ALPHA_BRODER_ID / ALPHA_BRODER_PASSWORD.

# The suppliers that may place real orders, comma-separated ids, e.g.
# OPENPROMO_ORDERS=sanmar,ssactivewear,acme
# "on" means SanMar and S&S Activewear only (never a directory supplier).
# Empty or "off": no supplier orders. An unknown id stops the server at start.
OPENPROMO_ORDERS=

# Serve only these suppliers (comma-separated ids). Default: all of them.
# OPENPROMO_ENABLED_SUPPLIERS=sanmar,ssactivewear

# Your own PromoStandards suppliers, as JSON (see README).
# OPENPROMO_SUPPLIERS=[{"id":"acme","name":"Acme","endpoints":{"inventory":{"version":"2.0.0","url":"https://..."}},"login":{"id":"...","password":"..."}}]

PORT=8787
